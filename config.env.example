NODE_ENV=development
PORT=3000
DATABASE=mongodb://127.0.0.1:27017/touroholic
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=90d
JWT_COOKIE_EXPIRES_IN=90

# Signup and login work without email. Enable SMTP for password recovery.
EMAIL_DISABLED=true
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=Touroholic <no-reply@example.com>

# Optional alternative to SMTP when both values are supplied:
SENDGRID_USERNAME=
SENDGRID_PASSWORD=

extends base

block content
  main.main
    .review-page.review-page__card
      h1.heading-secondary.ma-bt-md About Touroholic
      p.description__text Touroholic is a tour-booking demo where you can explore tours, create an account, reserve a tour, and share reviews. Reservations do not collect payment.
      h2.heading-secondary.login-help#apps Download apps
      p.description__text Use Touroholic in your desktop or mobile browser. There is no separate mobile app to download.
      h2.heading-secondary.login-help#guides Become a guide
      p.description__text Guide roles are assigned by the administrator of this installation. Contact your administrator if you would like to be listed as a guide.
      h2.heading-secondary.login-help#careers Careers
      p.description__text This demo does not publish job openings or accept applications.
      h2.heading-secondary.login-help#contact Contact
      p.description__text For help with your account or this installation, contact the person who provided you access to Touroholic.
      a.btn.btn--green.login-help(href='/') Explore tours

extends base

block append head
  script(src='/js/passwordRecovery.js' defer)

block content
  main.main
    .login-form
      h1.heading-secondary.ma-bt-md Forgot your password?
      p.form__label Enter your email and we'll send you a reset link.
      form.form.form--recovery(data-mode='forgot')
        .form__group
          label.form__label(for='recovery-email') Email address
          input#recovery-email.form__input(type='email' name='email' autocomplete='email' required)
        button.btn.btn--green(type='submit') Send reset link
        p.form__label.login-help#recovery-status(role='status' aria-live='polite')
      a.btn-text(href='/login') Back to login

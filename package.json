{
  "name": "touroholic",
  "version": "2.0.0",
  "description": "Tour discovery, demo bookings, and reviews",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "start:prod": "NODE_ENV=production node server.js",
    "watch:js": "node scripts/build-frontend.cjs --watch",
    "build:js": "node scripts/build-frontend.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:integration": "node --test tests/integration/app.integration.cjs",
    "seed": "node dev-data/data/import-dev-data.js --import",
    "lint": "eslint ."
  },
  "license": "ISC",
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "html-to-text": "^10.0.1",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "mongoose": "^9.10.1",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "pug": "^3.0.4",
    "sharp": "^0.35.4",
    "slugify": "^1.6.9",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "parcel": "^2.16.4",
    "prettier": "^3.0.0"
  }
}
